{
    "hosting": {
        "public": "dist",
        "ignore": [
            "firebase.json",
            "**/.*"
        ],
        "headers": [
            {
                "source": "**/*.@(js|css|png|jpg|jpeg|gif|ico|ttf|woff|woff2|svg)",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "max-age=31536000"
                    }
                ]
            },
            {
                "source": "index.html",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "no-cache, no-store, must-revalidate"
                    }
                ]
            }
        ],
        "rewrites": [
            {
                "source": "**",
                "destination": "/index.html"
            }
        ]
    }
}