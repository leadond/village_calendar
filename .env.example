# Village Calendar — environment template.
# Copy this file to ".env" and fill in your keys. ".env" is gitignored.
#   Copy-Item .env.example .env
# The PowerShell scripts in ./scripts read from .env automatically.

# --- Resend email (section 1 of PRODUCTION_SETUP.md) ---
# API key: https://resend.com/api-keys
RESEND_API_KEY=
# From-address must be on a domain verified at https://resend.com/domains
# (or use onboarding@resend.dev for a quick self-test)
RESEND_SENDER_EMAIL=no-reply@yourdomain.com
RESEND_SENDER_NAME=Village Calendar

# Supabase management API token: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# --- Supabase project (already set; anon key is public) ---
SUPABASE_URL=https://fmeizeyqwjieapfqgicl.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImZtZWl6ZXlxd2ppZWFwZnFnaWNsIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzAwMTMzMzUsImV4cCI6MjA4NTU4OTMzNX0.MbcDkt5b6XlTVL3tzTrjjJldeCag_GrfhItIhmnaFGU

# --- Optional production keys (see PRODUCTION_SETUP.md) ---
# Google Maps Static API key (live trip map)
GOOGLE_MAPS_API_KEY=
# RevenueCat platform SDK key (subscriptions)
REVENUECAT_API_KEY=
# RevenueCat webhook shared secret (matches the deployed edge function)
REVENUECAT_WEBHOOK_SECRET=

# Firebase web config (only for web push notifications)
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=
